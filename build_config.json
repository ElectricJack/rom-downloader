{
  "app": {
    "name": "ROMDownloader",
    "version": "1.0.0",
    "description": "ROM Download and Management Tool",
    "company": "ROM Downloader Project",
    "copyright": "© 2024 ROM Downloader Project"
  },
  "build": {
    "python_version": "3.11",
    "nuitka_version": ">=1.8.0",
    "target_architecture": "x86_64",
    "optimization_level": "high"
  },
  "nuitka": {
    "onefile": true,
    "standalone": false,
    "console_mode": "disable",
    "lto": true,
    "static_libpython": true,
    "remove_output": true,
    "assume_yes_for_downloads": true,
    "show_progress": true,
    "show_memory": true,
    "plugins": [
      "tk-inter",
      "multiprocessing"
    ],
    "include_packages": [
      "src",
      "config",
      "gui",
      "models",
      "downloader",
      "scraper",
      "processors",
      "filters",
      "tools",
      "state",
      "network",
      "rom_manager",
      "utils"
    ],
    "include_data_dirs": [
      {
        "source": "config",
        "target": "config"
      },
      {
        "source": "tools",
        "target": "tools"
      }
    ],
    "exclude_modules": [
      "test",
      "tests",
      "pytest",
      "unittest",
      "_pytest"
    ]
  },
  "packaging": {
    "create_zip": true,
    "include_files": [
      "README.md",
      "CLAUDE.md",
      "requirements.txt"
    ],
    "create_installer": false
  },
  "cross_compilation": {
    "mingw64": true,
    "wine_prefix": ""
  },
  "optimization": {
    "strip_debug": true,
    "compress_executable": true,
    "remove_unused_imports": true
  }
}